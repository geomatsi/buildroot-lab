BR2_riscv=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_GLOBAL_PATCH_DIR="board/orangepi/orangepi-rv/patches"
BR2_ROOTFS_OVERLAY="board/orangepi/orangepi-rv/overlay"
BR2_ROOTFS_POST_IMAGE_SCRIPT="board/orangepi/orangepi-rv/post-image.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.17-rc6"
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="starfive/jh7110-orangepi-rv"
